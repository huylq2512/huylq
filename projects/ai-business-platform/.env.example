# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- PostgreSQL (container) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_business
# host port; 5433 avoids clashing with a locally installed PostgreSQL on 5432
POSTGRES_PORT=5433
# must match the values above (password must be URL-safe, e.g. hex)
DATABASE_URL=postgresql+asyncpg://app:change-me@127.0.0.1:5433/ai_business

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# --- AI (needed from Phase 3) ---
OPENAI_API_KEY=
